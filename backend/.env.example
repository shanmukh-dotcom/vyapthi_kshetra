# Vyapti Kshetra Backend Environment Variables

# Gemini API Key (Get your key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
VISION_AI_API_KEY=your_vision_ai_api_key_here
TRANSPORT_API_KEY=your_transport_api_key_here

# Database URL (Defaults to SQLite for instant local execution if not specified)
# DATABASE_URL=postgresql://user:password@localhost:5432/vyaptikshetra
